# ==============================================================================
# Strata Configuration for Dual RTX 3060 12GB x 2, 48GB RAM
# Hardware note: P2P between GPU 0 and GPU 1 is active (PCIe P2P Direct Access)
# ==============================================================================

# Model family: qwen (Qwen3.8-Flash-Next) or swift (Swift 1.5) or coder
FAMILY=qwen

# Model quantization size:
# IQ2_XS : ~35.5GB RAM arena (Recommended for 48GB RAM host)
# Q2_0   : ~34.0GB RAM arena (Fastest, fits 48GB RAM)
# IQ1_M  : ~23.4GB RAM arena (Coder edition, fits 32GB RAM)
MODEL=IQ2_XS

# Context window length: 131072 = 128K (~130k tokens)
CONTEXT=131072

# Concurrent request slots: 4 requests decode simultaneously
PARALLEL=4

# KV Cache quantization: q4_0, k8v4, int8
# q4_0 saves ~50% VRAM per slot, essential for 130k context x 4 slots on 12GB GPUs
KV=q4_0

# KV Cache streaming: auto, on, off
# Keeps KV cache in RAM and streams only active window to VRAM
KV_STREAMING=auto

# Multi-GPU configuration: 'all' or '0,1' (splits layers across both RTX 3060 GPUs)
GPUS=all

# Layer split strategy: 'auto' (optimizes layer distribution by free VRAM)
LAYER_SPLIT=auto

# Multimodal / Vision support: yes, gpu, cpu, no
VISION=yes

# Server network settings
HOST=0.0.0.0
PORT=8080

# API Key (leave empty for no authentication, or set your secret)
API_KEY=

# Low RAM mode: auto, on, off
LOW_RAM=auto
